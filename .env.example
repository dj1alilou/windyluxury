# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/windyluxury?retryWrites=true&w=majority

# Server Configuration
PORT=4000

# Backend URL (used for self-ping in production)
# Set this to your Render backend URL after deployment
BACKEND_URL=https://your-backend-service.onrender.com

# Environment (production/development)
NODE_ENV=production

# Render specific
RENDER=true

# ZR Express Delivery API (optional)
ZR_EXPRESS_API_KEY=your_zrexpress_api_key
ZR_EXPRESS_TENANT_ID=your_zrexpress_tenant_id
ZR_EXPRESS_DEFAULT_HUB_ID=your_zrexpress_pickup_hub_id
ZR_EXPRESS_BASE_URL=https://api.zrexpress.app
ZR_EXPRESS_AUTO_CREATE_OFFICE=true
